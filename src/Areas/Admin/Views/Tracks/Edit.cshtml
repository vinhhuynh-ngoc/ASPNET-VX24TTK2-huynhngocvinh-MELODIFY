@model Melodify.Models.DTOs.EditTrackDto

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chỉnh sửa bài hát";
}

<div class="mb-4 text-white">
    <a href="/Admin/Tracks" class="text-secondary hover-underline text-decoration-none">
        <i class="bi bi-chevron-left me-2"></i>Quay lại danh sách
    </a>
    <h1 class="fw-bold fs-3 mt-3">Chỉnh sửa bài hát</h1>
</div>

<div class="card bg-dark text-white border-secondary p-4 rounded" style="background-color: var(--bg-card);">
    <form asp-area="Admin" asp-controller="Tracks" asp-action="Edit" asp-route-id="@Model.TrackId" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TrackId" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-12 col-md-6 mb-3">
                <label asp-for="Title" class="form-label fw-bold">Tiêu đề bài hát *</label>
                <input asp-for="Title" class="form-control bg-secondary text-white border-0" placeholder="Nhập tên bài hát" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label asp-for="Genre" class="form-label fw-bold">Thể loại</label>
                <input asp-for="Genre" class="form-control bg-secondary text-white border-0" placeholder="Ví dụ: Pop, Rap, Indie, Ballad" />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-12 col-md-6 mb-3">
                <label asp-for="ArtistId" class="form-label fw-bold">Nghệ sĩ trình bày *</label>
                <select asp-for="ArtistId" asp-items="ViewBag.Artists" class="form-select bg-secondary text-white border-0" required>
                </select>
                <span asp-validation-for="ArtistId" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6 mb-3">
                <label asp-for="AlbumId" class="form-label fw-bold">Album</label>
                <select asp-for="AlbumId" asp-items="ViewBag.Albums" class="form-select bg-secondary text-white border-0">
                    <option value="">-- Không có album --</option>
                </select>
                <span asp-validation-for="AlbumId" class="text-danger"></span>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12 col-md-6 mb-4">
                <label asp-for="NewAudioFile" class="form-label fw-bold">Tệp âm thanh mới (Không bắt buộc)</label>
                <input asp-for="NewAudioFile" type="file" class="form-control bg-secondary text-white border-0" accept=".mp3" />
                <span asp-validation-for="NewAudioFile" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6 mb-4">
                <label asp-for="NewCoverFile" class="form-label fw-bold">Ảnh bìa bài hát mới (Không bắt buộc)</label>
                <input asp-for="NewCoverFile" type="file" class="form-control bg-secondary text-white border-0" accept=".jpg,.jpeg,.png,.webp" />
                <span asp-validation-for="NewCoverFile" class="text-danger"></span>
                @if (!string.IsNullOrEmpty(ViewBag.CoverImage))
                {
                    <div class="mt-3">
                        <span class="d-block text-secondary mb-2">Ảnh bìa hiện tại:</span>
                        <img src="@ViewBag.CoverImage" style="width: 100px; height: 100px; object-fit: cover; border-radius: 4px;" alt="" />
                    </div>
                }
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success rounded-pill px-5 py-2 fw-bold text-dark me-3">Cập nhật bài hát</button>
            <a href="/Admin/Tracks" class="btn btn-outline-secondary rounded-pill px-5 py-2 fw-bold">Hủy</a>
        </div>
    </form>
</div>
