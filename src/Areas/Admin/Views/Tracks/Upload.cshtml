@model Melodify.Models.DTOs.UploadTrackDto

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tải lên bài hát";
}

<nav class="flex items-center gap-1 text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-6">
    <a class="hover:text-foreground active" href="/Admin" data-status="active" aria-current="page">Admin</a>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-3" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
    <a class="hover:text-foreground active" href="/Admin/Tracks" data-status="active" aria-current="page">Bài hát</a>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right size-3" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
    <span class="text-foreground">Tải lên</span>
</nav>
<h1 class="font-display text-3xl font-extrabold mb-6">Upload bài hát mới</h1>

<form asp-area="Admin" asp-controller="Tracks" asp-action="Upload" method="post" enctype="multipart/form-data" id="upload-form" class="grid gap-6 lg:grid-cols-[2fr_1fr]">
    @Html.AntiForgeryToken()
    
    <div class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

        <div class="rounded-2xl border-2 border-dashed border-border bg-surface p-8 text-center transition hover:border-lime relative group">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-upload mx-auto size-10 text-lime" aria-hidden="true"><path d="M12 3v12"></path><path d="m17 8-5-5-5 5"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path></svg>
            <p class="mt-3 font-semibold">Kéo &amp; thả file MP3 vào đây</p>
            <p class="text-xs text-muted-foreground">hoặc</p>
            <label class="mt-2 inline-block cursor-pointer rounded-full border border-border px-4 py-2 text-sm font-semibold hover:border-lime">
                <input asp-for="AudioFile" accept=".mp3,audio/mpeg" class="hidden" type="file" required>
                Chọn file
            </label>
            <div class="mt-2 text-sm text-lime hidden" id="audio-file-name"></div>
            <span asp-validation-for="AudioFile" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <label class="block">
            <span class="mb-1 block text-xs font-semibold uppercase tracking-widest text-muted-foreground">Tên bài *</span>
            <input asp-for="Title" required class="h-11 w-full rounded-xl border border-border bg-background px-3 text-sm focus:border-lime focus:outline-none">
            <span asp-validation-for="Title" class="text-red-500 text-xs mt-1 block"></span>
        </label>

        <div class="grid gap-4 md:grid-cols-2">
            <label class="block">
                <span class="mb-1 block text-xs font-semibold uppercase tracking-widest text-muted-foreground">Nghệ sĩ *</span>
                <select asp-for="ArtistId" asp-items="ViewBag.Artists" class="h-11 w-full rounded-xl border border-border bg-background px-3 text-sm focus:border-lime focus:outline-none" required>
                    <option value="">-- Chọn nghệ sĩ --</option>
                </select>
                <span asp-validation-for="ArtistId" class="text-red-500 text-xs mt-1 block"></span>
            </label>

            <label class="block">
                <span class="mb-1 block text-xs font-semibold uppercase tracking-widest text-muted-foreground">Album</span>
                <select asp-for="AlbumId" asp-items="ViewBag.Albums" class="h-11 w-full rounded-xl border border-border bg-background px-3 text-sm focus:border-lime focus:outline-none">
                    <option value="">-- Không có album --</option>
                </select>
                <span asp-validation-for="AlbumId" class="text-red-500 text-xs mt-1 block"></span>
            </label>
        </div>

        <label class="block">
            <span class="mb-1 block text-xs font-semibold uppercase tracking-widest text-muted-foreground">Thể loại</span>
            <input asp-for="Genre" type="hidden" id="genre-input" />
            <div class="flex flex-wrap gap-2" id="genre-buttons">
                <button type="button" class="genre-btn rounded-full px-3 py-1.5 text-xs font-semibold transition border border-border text-foreground/70 hover:border-lime">V-Pop</button>
                <button type="button" class="genre-btn rounded-full px-3 py-1.5 text-xs font-semibold transition border border-border text-foreground/70 hover:border-lime">K-Pop</button>
                <button type="button" class="genre-btn rounded-full px-3 py-1.5 text-xs font-semibold transition border border-border text-foreground/70 hover:border-lime">R&amp;B</button>
                <button type="button" class="genre-btn rounded-full px-3 py-1.5 text-xs font-semibold transition border border-border text-foreground/70 hover:border-lime">Ballad</button>
                <button type="button" class="genre-btn rounded-full px-3 py-1.5 text-xs font-semibold transition border border-border text-foreground/70 hover:border-lime">Acoustic</button>
                <button type="button" class="genre-btn rounded-full px-3 py-1.5 text-xs font-semibold transition border border-border text-foreground/70 hover:border-lime">Rap</button>
                <button type="button" class="genre-btn rounded-full px-3 py-1.5 text-xs font-semibold transition border border-border text-foreground/70 hover:border-lime">EDM</button>
                <button type="button" class="genre-btn rounded-full px-3 py-1.5 text-xs font-semibold transition border border-border text-foreground/70 hover:border-lime">OST</button>
            </div>
            <span asp-validation-for="Genre" class="text-red-500 text-xs mt-1 block"></span>
        </label>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="rounded-full bg-lime px-5 py-2.5 text-sm font-bold text-lime-foreground">Lưu bài hát</button>
            <a class="rounded-full border border-border px-5 py-2.5 text-sm font-semibold flex items-center justify-center text-foreground hover:bg-border/50" href="/Admin/Tracks">Hủy</a>
        </div>
        
        <div class="w-full bg-border rounded-full h-2 mt-4 hidden" id="progress-container">
            <div class="bg-lime h-2 rounded-full" style="width: 0%" id="upload-progress"></div>
        </div>
    </div>

    <div>
        <label class="block">
            <span class="mb-1 block text-xs font-semibold uppercase tracking-widest text-muted-foreground">Ảnh bìa</span>
            <label class="grid h-[200px] w-[200px] cursor-pointer place-items-center overflow-hidden rounded-xl border-2 border-dashed border-border bg-surface hover:border-lime relative" id="cover-preview-container">
                <input asp-for="CoverFile" accept="image/*" class="hidden" type="file" id="cover-upload">
                <div class="text-center text-muted-foreground" id="cover-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-image mx-auto size-8" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
                    <p class="mt-2 text-xs">200×200</p>
                </div>
                <img id="cover-preview" class="absolute inset-0 w-full h-full object-cover hidden" />
            </label>
            <span asp-validation-for="CoverFile" class="text-red-500 text-xs mt-1 block"></span>
        </label>
    </div>
</form>

@section Scripts {
    <script>
        // Handle genre buttons
        const genreInput = document.getElementById('genre-input');
        const genreButtons = document.querySelectorAll('.genre-btn');
        
        // If there's an existing genre, mark it active
        const currentGenre = genreInput.value;
        if(currentGenre) {
            genreButtons.forEach(btn => {
                if(btn.innerText.toLowerCase() === currentGenre.toLowerCase()) {
                    btn.classList.remove('text-foreground/70', 'border-border');
                    btn.classList.add('bg-lime', 'text-lime-foreground', 'border-lime');
                }
            });
        }

        genreButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                // Update styling
                genreButtons.forEach(b => {
                    b.classList.remove('bg-lime', 'text-lime-foreground', 'border-lime');
                    b.classList.add('text-foreground/70', 'border-border');
                });
                
                btn.classList.remove('text-foreground/70', 'border-border');
                btn.classList.add('bg-lime', 'text-lime-foreground', 'border-lime');
                
                // Update input
                genreInput.value = btn.innerText;
            });
        });

        // Handle audio file name display
        const audioInput = document.getElementById('AudioFile');
        const audioFileName = document.getElementById('audio-file-name');
        
        if(audioInput) {
            audioInput.addEventListener('change', function() {
                if(this.files && this.files[0]) {
                    audioFileName.textContent = 'Đã chọn: ' + this.files[0].name;
                    audioFileName.classList.remove('hidden');
                } else {
                    audioFileName.classList.add('hidden');
                }
            });
        }

        // Handle cover preview
        const coverUpload = document.getElementById('cover-upload');
        const coverPreview = document.getElementById('cover-preview');
        const coverPlaceholder = document.getElementById('cover-placeholder');
        
        if (coverUpload) {
            coverUpload.addEventListener('change', function() {
                if (this.files && this.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        coverPreview.src = e.target.result;
                        coverPreview.classList.remove('hidden');
                        coverPlaceholder.classList.add('hidden');
                    }
                    reader.readAsDataURL(this.files[0]);
                } else {
                    coverPreview.classList.add('hidden');
                    coverPlaceholder.classList.remove('hidden');
                }
            });
        }

        // Simple progress bar mock
        $('#upload-form').on('submit', function() {
            if (this.checkValidity()) {
                $('#progress-container').removeClass('hidden');
                let progress = 0;
                const interval = setInterval(function() {
                    progress += 10;
                    if (progress >= 90) {
                        clearInterval(interval);
                    }
                    $('#upload-progress').css('width', progress + '%');
                }, 200);
            }
        });
    </script>
}
