<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Melodify Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#09090b',
                        foreground: '#fafafa',
                        sidebar: {
                            DEFAULT: '#121212',
                            border: 'rgba(255, 255, 255, 0.08)',
                            accent: 'rgba(255, 255, 255, 0.05)',
                            foreground: 'rgba(255, 255, 255, 0.7)',
                        },
                        lime: {
                            DEFAULT: '#adfa1d',
                            foreground: '#09090b',
                        },
                        border: 'rgba(255, 255, 255, 0.08)',
                        muted: {
                            DEFAULT: 'rgba(255, 255, 255, 0.1)',
                            foreground: '#a1a1aa',
                        },
                        destructive: {
                            DEFAULT: '#ef4444',
                            foreground: '#f8fafc',
                        },
                        surface: '#09090b',
                    },
                    fontFamily: {
                        display: ['Plus Jakarta Sans', 'sans-serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body>
    <div class="flex h-screen bg-background text-foreground">
        <aside class="hidden w-[240px] shrink-0 flex-col gap-2 border-r border-sidebar-border bg-sidebar p-4 md:flex">
            <div class="mb-3 flex items-center gap-2 px-2">
                <div class="grid size-9 place-items-center rounded-xl bg-lime text-lime-foreground font-bold">M</div>
                <div>
                    <div class="font-display text-base font-extrabold">Melodify</div>
                    <div class="text-[11px] uppercase tracking-widest text-muted-foreground">Admin</div>
                </div>
            </div>
            
            @{
                var controller = ViewContext.RouteData.Values["controller"]?.ToString();
            }
            
            <nav class="flex flex-col gap-1">
                <a href="/Admin/Tracks" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition @(controller == "Tracks" ? "bg-sidebar-accent !text-lime" : "text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-foreground")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
                    Bài hát
                </a>
                <a href="/Admin/Artists" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition @(controller == "Artists" ? "bg-sidebar-accent !text-lime" : "text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-foreground")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    Nghệ sĩ
                </a>
                <a href="/Admin/Albums" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold transition @(controller == "Albums" ? "bg-sidebar-accent !text-lime" : "text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-foreground")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                    Album
                </a>
            </nav>
            <div class="mt-auto">
                <a href="/" class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm text-muted-foreground transition hover:text-foreground">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="m15 18-6-6 6-6"></path></svg> 
                    Về ứng dụng
                </a>
            </div>
        </aside>
        
        <main class="flex-1 overflow-y-auto">
            @using Microsoft.AspNetCore.Identity
            @using Melodify.Models.Entities
            @inject UserManager<User> UserManager
            @{
                var user = await UserManager.GetUserAsync(User);
                var fullName = !string.IsNullOrWhiteSpace(user?.FullName) ? user.FullName : (user?.Email ?? "Admin");
            }
            <div class="sticky top-0 z-10 flex items-center justify-end border-b border-border/40 bg-surface/80 px-6 py-4 backdrop-blur-md md:px-10">
                <div class="font-display text-sm font-bold">
                    Xin chào, <span class="text-lime">@fullName</span>
                </div>
            </div>
            <div class="space-y-6 p-6 md:p-10">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="p-4 bg-lime/10 text-lime border border-lime/20 rounded-xl">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="p-4 bg-destructive/10 text-destructive border border-destructive/20 rounded-xl">@TempData["ErrorMessage"]</div>
                }
                
                @RenderBody()
            </div>
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
