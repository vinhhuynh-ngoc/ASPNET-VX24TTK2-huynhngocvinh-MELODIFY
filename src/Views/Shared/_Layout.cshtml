<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Melodify</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/site.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#09090b',
                        foreground: '#fafafa',
                        sidebar: {
                            DEFAULT: '#121212',
                            border: 'rgba(255, 255, 255, 0.08)',
                            accent: 'rgba(255, 255, 255, 0.05)',
                            foreground: 'rgba(255, 255, 255, 0.7)',
                        },
                        lime: {
                            DEFAULT: '#adfa1d',
                            foreground: '#09090b',
                        },
                        border: 'rgba(255, 255, 255, 0.08)',
                        muted: {
                            DEFAULT: 'rgba(255, 255, 255, 0.1)',
                            foreground: '#a1a1aa',
                        },
                        'surface-2': '#18181b',
                        'surface': '#09090b',
                    },
                    fontFamily: {
                        display: ['Plus Jakarta Sans', 'sans-serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body>
    <div class="flex h-screen flex-col bg-background text-foreground">
        <div class="flex min-h-0 flex-1">
            <partial name="_Sidebar" />
            <main class="main-content flex min-w-0 flex-1 flex-col">
                <header class="sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-border/40 bg-background/70 px-6 backdrop-blur-xl">
                    <div class="flex-1">
                        @if (ViewData["ShowSearch"] != null && (bool)ViewData["ShowSearch"])
                        {
                            <div class="relative max-w-xs">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-muted-foreground">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input type="text" id="search-input" class="w-full h-9 pl-9 pr-4 rounded-full bg-white/5 border border-border/60 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:border-lime" placeholder="Bạn muốn nghe gì?" autocomplete="off" />
                            </div>
                        }
                    </div>
                    
                    <div class="flex items-center gap-3">
                        @if (User.Identity.IsAuthenticated)
                        {
                            var name = User.Identity.Name ?? "User";
                            var initial = name.Length > 0 ? name.Substring(0, Math.Min(2, name.Length)).ToUpper() : "US";
                            
                            @if (User.IsInRole("Admin"))
                            {
                                <a href="/Admin/Tracks" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-border/60 text-foreground/80 hover:bg-white/5 transition">Admin Panel</a>
                            }
                            
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-border/60 text-foreground/80 hover:bg-white/5 transition">Đăng xuất</button>
                            </form>
                            
                            <div class="relative">
                                <button class="grid size-9 place-items-center rounded-full bg-lime text-sm font-bold text-lime-foreground" title="@name">
                                    @initial
                                </button>
                            </div>
                        }
                        else
                        {
                            <a href="/Account/Login" class="text-xs font-semibold px-4 py-1.5 rounded-full bg-lime text-lime-foreground transition hover:scale-105">Đăng nhập</a>
                        }
                    </div>
                </header>
                
                <div class="flex-1 overflow-y-auto">
                    @RenderBody()
                </div>
            </main>
        </div>
        
        <partial name="_PlayerBar" />
    </div>

    <div class="modal fade" id="createPlaylistModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary">
                <form asp-controller="Playlist" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title">Tạo danh sách phát mới</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Tên danh sách phát</label>
                            <input type="text" name="name" class="form-control bg-secondary text-white border-0" required placeholder="Ví dụ: My Favorite Songs" />
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4">Tạo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/player.js"></script>
    <script src="/js/spa.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
