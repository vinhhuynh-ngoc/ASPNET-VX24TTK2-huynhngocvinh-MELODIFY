@model Melodify.Models.HomeViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Trang chủ";
    var tracksJson = JsonSerializer.Serialize(Model.FeaturedTracks, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<div class="space-y-10 p-6 md:p-8">
    <section class="relative overflow-hidden rounded-3xl border border-border/40 bg-gradient-to-br from-surface-2 to-surface p-8 md:p-10">
        <div class="absolute -right-12 -top-12 size-56 rounded-full bg-lime/30 blur-3xl"></div>
        <div class="absolute -bottom-16 left-16 size-44 rounded-full bg-fuchsia-500/20 blur-3xl"></div>
        <div class="relative max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-widest text-lime">Melodify</p>
            <h1 class="mt-2 font-display text-4xl font-extrabold leading-tight md:text-5xl">@Html.Raw(Model.Greeting)</h1>
            <p class="mt-3 max-w-xl text-muted-foreground">Hôm nay là một ngày đẹp trời để khám phá những giai điệu mới. Đã chọn sẵn vài đề xuất cho bạn.</p>
            <div class="mt-6 flex flex-wrap gap-2">
                <button class="rounded-full px-4 py-1.5 text-sm font-semibold transition bg-lime text-lime-foreground">Tất cả</button>
                <button class="rounded-full px-4 py-1.5 text-sm font-semibold transition border border-border/60 text-foreground/80 hover:bg-white/5" onclick="navigateTo('/Search')">Nhạc</button>
                <button class="rounded-full px-4 py-1.5 text-sm font-semibold transition border border-border/60 text-foreground/80 hover:bg-white/5" onclick="navigateTo('/Library')">Thư viện</button>
            </div>
        </div>
    </section>

    @if (Model.RecentAlbums != null && Model.RecentAlbums.Any())
    {
        <section>
            <h2 class="mb-4 font-display text-xl font-bold">Mới phát gần đây</h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var album in Model.RecentAlbums)
                {
                    <a href="/Album/Detail/@album.AlbumId" class="group flex items-center gap-3 overflow-hidden rounded-xl bg-white/5 pr-3 transition hover:bg-white/10">
                        <img src="@album.CoverImage" onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=150&h=150&fit=crop'" alt="" class="size-12 shrink-0 object-cover" />
                        <span class="min-w-0 flex-1 truncate text-sm font-semibold">@album.Title</span>
                        <button class="grid size-9 shrink-0 translate-x-2 place-items-center rounded-full bg-lime text-lime-foreground opacity-0 transition group-hover:translate-x-0 group-hover:opacity-100">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play size-4" aria-hidden="true">
                                <path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path>
                            </svg>
                        </button>
                    </a>
                }
            </div>
        </section>
    }

    @if (Model.FeaturedTracks != null && Model.FeaturedTracks.Any())
    {
        <section>
            <div class="mb-4 flex items-end justify-between">
                <h2 class="font-display text-xl font-bold">Khám phá hôm nay</h2>
            </div>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5">
                @for (int i = 0; i < Model.FeaturedTracks.Count; i++)
                {
                    var track = Model.FeaturedTracks[i];
                    var index = i;
                    <div class="group relative flex flex-col gap-3 rounded-2xl bg-white/5 p-4 transition hover:bg-white/10 cursor-pointer" onclick="navigateTo('/Album/Detail/@(track.AlbumId ?? 0)')">
                        <div class="relative">
                            <img src="@track.CoverImage" onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=300&h=300&fit=crop'" alt="" class="aspect-square w-full rounded-xl object-cover shadow-lg" />
                            <button class="absolute bottom-2 right-2 grid size-11 translate-y-2 place-items-center rounded-full bg-lime text-lime-foreground opacity-0 shadow-xl transition group-hover:translate-y-0 group-hover:opacity-100" onclick="event.stopPropagation(); playFeaturedTrack(@index)">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play size-5" aria-hidden="true">
                                    <path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path>
                                </svg>
                            </button>
                        </div>
                        <div class="min-w-0">
                            <div class="truncate font-semibold">@track.Title</div>
                            <div class="truncate text-xs text-muted-foreground">@track.ArtistName</div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.SuggestedArtists != null && Model.SuggestedArtists.Any())
    {
        <section>
            <h2 class="mb-4 font-display text-xl font-bold">Nghệ sĩ bạn có thể thích</h2>
            <div class="-mx-2 flex gap-6 overflow-x-auto px-2 pb-2">
                @foreach (var artist in Model.SuggestedArtists)
                {
                    <a href="/Artist/Detail/@artist.ArtistId" class="group flex w-32 shrink-0 flex-col items-center gap-3 text-center">
                        <img src="@artist.ImageUrl" onerror="this.src='https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=150&h=150&fit=crop'" alt="" class="size-28 rounded-full object-cover shadow-lg ring-2 ring-transparent transition group-hover:ring-lime" />
                        <div class="text-sm font-semibold truncate w-full">@artist.Name</div>
                    </a>
                }
            </div>
        </section>
    }

    @if (Model.FeaturedPlaylists != null && Model.FeaturedPlaylists.Any())
    {
        <section>
            <h2 class="mb-4 font-display text-xl font-bold">Playlist nổi bật</h2>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5">
                @foreach (var playlist in Model.FeaturedPlaylists)
                {
                    <a href="/Playlist/Detail/@playlist.PlaylistId" class="group flex flex-col gap-3 rounded-2xl bg-white/5 p-4 transition hover:bg-white/10">
                        <img src="/uploads/covers/playlist-default.png" onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=300&h=300&fit=crop'" class="aspect-square w-full rounded-xl object-cover" alt="" />
                        <div class="min-w-0">
                            <div class="truncate font-semibold">@playlist.Name</div>
                            <div class="truncate text-xs text-muted-foreground">Danh sách phát · @playlist.UserName</div>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    <section class="mt-8">
        <h2 class="mb-4 font-display text-xl font-bold">Tất cả bài hát</h2>
        <div class="track-table-container overflow-x-auto rounded-lg border border-border/40 bg-surface">
            <table class="w-full text-left text-sm track-table">
                <thead class="border-b border-border/40 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    <tr>
                        <th class="px-4 py-3 font-medium w-12">#</th>
                        <th class="px-4 py-3 font-medium">Tiêu đề</th>
                        <th class="px-4 py-3 font-medium">Thể loại</th>
                        <th class="px-4 py-3 font-medium text-right rounded-tr-lg">Thời lượng</th>
                    </tr>
                </thead>
                <tbody id="home-tracks-list" class="divide-y divide-border/20">
                    <!-- Tracks will be dynamically injected here -->
                </tbody>
            </table>
        </div>
        <div id="home-load-more-container" class="mt-4 flex justify-center" style="display: none;">
            <button id="home-load-more-btn" class="px-6 py-2 rounded-full border border-border/60 hover:bg-white/5 transition font-medium text-sm">Xem thêm</button>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        var featuredTracks = @Html.Raw(tracksJson);

        function playFeaturedTrack(index) {
            setPlaylist(featuredTracks, index);
        }

        // Home All Tracks Logic
        var currentHomeTracks = [];
        var currentHomePage = 1;
        var totalHomePages = 1;

        $(document).ready(function() {
            loadHomeTracks(1, false);
        });

        $(document).off('click', '#home-load-more-btn').on('click', '#home-load-more-btn', function() {
            if (currentHomePage < totalHomePages) {
                loadHomeTracks(currentHomePage + 1, true);
            }
        });

        function loadHomeTracks(page, append) {
            $.get('/Home/GetTracks', { page: page }, function(data) {
                currentHomePage = data.page;
                totalHomePages = data.totalPages;
                
                if (append) {
                    currentHomeTracks = currentHomeTracks.concat(data.items);
                } else {
                    currentHomeTracks = data.items;
                }
                
                renderHomeTracks(data.items, append);
            });
        }

        function renderHomeTracks(tracks, append) {
            const tbody = $('#home-tracks-list');
            
            if (!append) {
                tbody.empty();
            }

            const startIndex = append ? currentHomeTracks.length - tracks.length : 0;

            tracks.forEach((track, index) => {
                const globalIndex = startIndex + index;
                const row = $(`
                    <tr class="track-row hover:bg-white/5 transition cursor-pointer" data-track-id="${track.trackId}">
                        <td class="px-4 py-3 text-muted-foreground">${globalIndex + 1}</td>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-3">
                                <img src="${track.coverImage || '/uploads/covers/default.png'}" onerror="this.src='https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=100&h=100&fit=crop'" class="size-10 rounded object-cover" alt="" />
                                <div class="flex flex-col">
                                    <span class="font-medium text-foreground track-title-cell">${track.title}</span>
                                    <span class="text-xs text-muted-foreground">${track.artistName}</span>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3 text-muted-foreground">${track.genre || ''}</td>
                        <td class="px-4 py-3 text-right text-muted-foreground">${formatTime(track.duration)}</td>
                    </tr>
                `);

                row.on('click', function() {
                    setPlaylist(currentHomeTracks, globalIndex);
                });

                tbody.append(row);
            });

            if (typeof window.currentTrackId !== 'undefined' && window.currentTrackId) {
                $(`.track-row[data-track-id="${window.currentTrackId}"]`).addClass('playing');
                $(`.track-row[data-track-id="${window.currentTrackId}"] .track-title-cell`).addClass('text-lime').removeClass('text-foreground');
            }

            if (currentHomePage < totalHomePages) {
                $('#home-load-more-container').show();
            } else {
                $('#home-load-more-container').hide();
            }
        }

        function formatTime(secs) {
            const minutes = Math.floor(secs / 60) || 0;
            const seconds = Math.floor(secs % 60) || 0;
            return minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
        }
    </script>
}
