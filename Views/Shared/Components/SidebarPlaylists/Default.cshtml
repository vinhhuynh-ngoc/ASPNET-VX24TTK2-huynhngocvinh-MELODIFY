@model IEnumerable<Melodify.Models.DTOs.PlaylistDto>

@foreach (var playlist in Model)
{
    <li>
        <a href="/Playlist/Detail/@playlist.PlaylistId" class="playlist-item block truncate rounded-lg px-3 py-1.5 text-[13px] text-sidebar-foreground/60 transition hover:text-sidebar-foreground">
            @playlist.Name
        </a>
    </li>
}
