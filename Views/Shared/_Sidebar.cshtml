<aside class="hidden w-[220px] shrink-0 flex-col gap-2 border-r border-sidebar-border bg-sidebar p-4 md:flex">
    <a class="mb-3 flex items-center gap-2 px-2" href="/">
        <div class="grid size-9 place-items-center rounded-xl bg-lime text-lime-foreground">
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor">
                <path d="M9 17V5l10-2v12"></path>
                <circle cx="6" cy="17" r="3"></circle>
                <circle cx="16" cy="15" r="3"></circle>
            </svg>
        </div>
        <span class="font-display text-xl font-extrabold tracking-tight">Melodify<span class="text-lime">.</span></span>
    </a>
    <nav class="flex flex-col gap-1">
        <a class="sidebar-nav-item group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sidebar-foreground/70 transition hover:bg-sidebar-accent hover:text-sidebar-foreground" href="/">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house size-5 shrink-0" aria-hidden="true">
                <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
                <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            </svg>
            <span class="truncate">Trang chủ</span>
        </a>
        <a class="sidebar-nav-item group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sidebar-foreground/70 transition hover:bg-sidebar-accent hover:text-sidebar-foreground" href="/Search">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search size-5 shrink-0" aria-hidden="true">
                <path d="m21 21-4.34-4.34"></path>
                <circle cx="11" cy="11" r="8"></circle>
            </svg>
            <span class="truncate">Tìm kiếm</span>
        </a>
        <a class="sidebar-nav-item group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-sidebar-foreground/70 transition hover:bg-sidebar-accent hover:text-sidebar-foreground" href="/Library">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-library size-5 shrink-0" aria-hidden="true">
                <path d="m16 6 4 14"></path>
                <path d="M12 6v14"></path>
                <path d="M8 8v12"></path>
                <path d="M4 4v16"></path>
            </svg>
            <span class="truncate">Thư viện</span>
        </a>
    </nav>
    <div class="mt-4 border-t border-sidebar-border pt-3">
        <div class="mb-2 px-2 text-[11px] font-bold uppercase tracking-widest text-sidebar-foreground/50">Playlist của bạn</div>
        <button class="flex w-full items-center gap-3 rounded-xl px-3 py-2 text-sm font-semibold text-sidebar-foreground/80 transition hover:bg-sidebar-accent hover:text-sidebar-foreground" id="btn-create-playlist-sidebar" data-bs-toggle="modal" data-bs-target="#createPlaylistModal">
            <span class="grid size-7 place-items-center rounded-md bg-white/10">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-4" aria-hidden="true">
                    <path d="M5 12h14"></path>
                    <path d="M12 5v14"></path>
                </svg>
            </span>
            Tạo playlist
        </button>
        <a class="playlist-item flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-semibold text-sidebar-foreground/80 transition hover:bg-sidebar-accent hover:text-sidebar-foreground" href="/Library?tab=liked">
            <span class="grid size-7 place-items-center rounded-md bg-gradient-to-br from-fuchsia-500 to-indigo-400 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart size-4" aria-hidden="true">
                    <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path>
                </svg>
            </span>
            Bài đã thích
        </a>
    </div>
    <div class="mt-2 flex-1 overflow-y-auto pr-1">
        <ul class="space-y-1">
            @await Component.InvokeAsync("SidebarPlaylists")
        </ul>
    </div>
</aside>
